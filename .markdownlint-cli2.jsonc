// Markdown lint for every *.md file. MD013 (line length) is off: spec and
// ADR tables have long rows that cannot wrap.
{
  "config": { "MD013": false },
  "ignores": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    ".superpowers/**",
    // Local Claude Code agent checkouts, not repo files.
    ".claude/worktrees/**",
    // Claude Design export, kept as received for the redesign v2 spec.
    "docs/design-system/**"
  ]
}
